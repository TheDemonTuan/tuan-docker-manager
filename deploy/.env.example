# Docker Compose Panel Environment Configuration

# Core Configuration
LISTEN_ADDR=:8080
DEV_MODE=false
DB_PATH=/data/panel.db
MASTER_KEY_PATH=/data/secrets/master.key
STACKS_ROOT=/srv/docker-panel/stacks
BACKUP_DIR=/data/backups
AGENT_SOCKET_URL=/run/panel-agent/agent.sock

# Authentication & Cloudflare Access
# Comma-separated list of allowed emails from Cloudflare Access (e.g. admin@example.com,user@example.com)
ALLOWED_EMAILS=admin@example.com
ADMIN_EMAIL=admin@example.com

# Cloudflare Tunnel Token (if running cloudflared in compose)
# Obtain this token from Cloudflare Zero Trust Dashboard -> Access -> Tunnels
TUNNEL_TOKEN=
