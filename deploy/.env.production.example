# Copy to /opt/tuan-docker-manager/.env and chmod 600.
# This file remains only on the VPS; GitHub Actions never overwrites it.

# Store the Cloudflare token separately in /opt/tuan-docker-manager/.tunnel-token (mode 0600).
ALLOWED_EMAILS=admin@example.com
ADMIN_EMAIL=admin@example.com
STACKS_HOST_PATH=/srv/docker-panel/stacks
